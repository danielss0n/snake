ROUTINE SNAKE
	; 
	; D ^SNAKE
	;
	N ENDR S ENDR=0		; END ROUTINE
IN	N Z S Z="^"		; PIECE
	N TL K TL		; TILE SET
	S TL("BLANK")="."		; BLANK TILE
	S TL("PLAYER")="X"	; PLAYER TILE
	S TL("FRUIT")="O"		; FRUIT TILE  
	N BOARD K BOARD		; BOARD DATA
	K BOARDW S BOARDW=20	; BOARD WIDTH
	K BOARDH S BOARDH=20	; BOARD HEIGHT
	N PX S PX=$R(BOARDW)+1	; PLAYER HEAD X POSITION
	N PY S PY=$R(BOARDH)+1	; PLAYER HEAD Y POSITION
	N SQ S SQ=1		; PLAYER MOVE SEQUENCE
	N BODY K BODY		; 
	S BODY(1,PX,PY)=""	; PLAYER BODY IN BOARD
	N LKEY S LKEY=""		; PLAYER LAST KEY PRESS
	N MVDIR K MVDIR		; 
	S MVDIR(0,0)=""		; MOVE DIRECTION
	N SIZE S SIZE=1		; PLAYER SIZE
	N LHANG S LHANG=0.1	; LOOP HANG
	N OVER S OVER=0		; GAME OVER
	N AGAIN S AGAIN=""	;
	F Y=1:1:BOARDH D
	. F X=1:1:BOARDW D
	. . S BOARD(X,Y)=TL("BLANK")
	D FR
	F  Q:ENDR  D
	. I OVER D END
	. Q:ENDR
	. R *%:0 I %'=-1 S LKEY=$C(%)
	. D LP H LHANG
	W # Q
LP	N CELL,CS,FP,MX,MY,NBODY,RX,RY,SEQ,X,Y
	S SEQ="",CS=1
	I $ZCVT(LKEY,"U")="A" D
	. I ($D(MVDIR(1,0)))&&(SIZE>1) Q
	. K MVDIR S MVDIR(-1,0)=""
	I $ZCVT(LKEY,"U")="D" D
	. I ($D(MVDIR(-1,0)))&&(SIZE>1) Q
	. K MVDIR S MVDIR(1,0)=""
	I $ZCVT(LKEY,"U")="W" D
	. I ($D(MVDIR(0,1)))&&(SIZE>1) Q
	. K MVDIR S MVDIR(0,-1)=""
	I $ZCVT(LKEY,"U")="S" D
	. I ($D(MVDIR(0,-1)))&&(SIZE>1) Q
	. K MVDIR S MVDIR(0,1)=""
	I LKEY'="" D 
	. S CELL=BOARD(PX,PY)
	. S MX=$O(MVDIR(""))
	. S MY=$O(MVDIR(MX,""))
	. I '$D(BOARD(PX+MX,PY+MY)) S OVER=1
	. F  S SEQ=$O(BODY(SEQ),-1) Q:SEQ=""  D
	. . I $D(BODY(SEQ,PX+MX,PY+MY)) S OVER=1
	. I OVER Q
	. S BODY(SQ,PX,PY)=""
	. S SQ=SQ+1
	. S BODY(SQ,PX+MX,PY+MY)=""
	. I CELL=TL("FRUIT") D  D FR
	. . S SIZE=SIZE+1
	. . S BOARD(PX,PY)=TL("BLANK")
	. . S LHANG=LHANG-0.0001
	. S PX=PX+MX,PY=PY+MY
	. F  S SEQ=$O(BODY(SEQ),-1) Q:SEQ=""  D
	. . I CS>SIZE K BODY(SEQ)
	. . S CS=$I(CS)
	W # W "CONTROLES: W,A,S,D"
	F Y=1:1:BOARDH D
	. W !
	. F X=1:1:BOARDW D
	. . S (FP,SEQ)=""
	. . F  S SEQ=$O(BODY(SEQ)) Q:SEQ=""  D
	. . . I $D(BODY(SEQ,X,Y)) D
	. . . . W " "_TL("PLAYER")
	. . . . S FP=1
	. . IF 'FP W " "_BOARD(X,Y)
	W !,"SCORE....: "_SIZE
	W !,"MAX SCORE: "_$G(^MAXSIZE) W !
	Q
FR	N PF,SEQ
	S (PF,SEQ)=""
	F  Q:PF  D
	. S PF=1
	. S RX=$R(BOARDW)+1
	. S RY=$R(BOARDH)+1
	. F  S SEQ=$O(BODY(SEQ),-1) Q:SEQ=""  D  Q:'PF
	. . I $D(BODY(SEQ,RX,RY)) S PF=0
	S BOARD(RX,RY)=TL("FRUIT")
	Q
END	I SIZE>$G(^MAXSIZE) S ^MAXSIZE=SIZE
	R "JOGAR NOVAMENTE? S OU N (S): ",AGAIN
	I $ZCVT(AGAIN,"U")'="N" G IN
	S ENDR=1
	Q